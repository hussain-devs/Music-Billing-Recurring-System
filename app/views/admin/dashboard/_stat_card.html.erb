<div class="col-md-6 col-xl-3">
  <div class="card shadow-sm h-100">
    <div class="card-body d-flex flex-column">
      <h6 class="text-muted"><%= title %></h6>
      <h2><%= count %></h2>

      <% if path %>
        <div class="mt-auto">
          <%= link_to link_text,
              path,
              class: "btn btn-sm btn-outline-primary" %>
        </div>
      <% end %>
    </div>
  </div>
</div>
