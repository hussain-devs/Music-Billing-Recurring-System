<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <h1 class="mb-1">My Subscriptions</h1>
    <p class="text-muted mb-0">
      View your active music subscriptions.
    </p>
  </div>

  <%= link_to "Browse Plans", plans_path, class: "btn btn-primary" %>
</div>

<% if @subscriptions.any? %>
  <div class="row g-4">
    <%= render partial: "subscription",
               collection: @subscriptions,
               as: :subscription %>
  </div>
<% else %>
  <div class="card shadow-sm">
    <div class="card-body text-center py-5">
      <h4 class="mb-2">No subscriptions yet</h4>

      <p class="text-muted mb-4">
        You don't have any subscriptions.
        Browse our available plans to get started.
      </p>

      <%= link_to "Browse Plans", plans_path, class: "btn btn-primary" %>
    </div>
  </div>
<% end %>
