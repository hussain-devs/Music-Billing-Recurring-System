<% status = subscription.subscription_statuses.last %>

<div class="col-md-6 col-xl-4">
  <div class="card shadow-sm h-100">
    <div class="card-body d-flex flex-column">
      <h4 class="card-title mb-3"><%= subscription.plan.name %></h4>

      <h5 class="mb-4">
        <%= number_to_currency(subscription.plan.monthly_fee) %>
        <small class="text-muted fs-6">/ month</small>
      </h5>

      <p>
        <strong>Started:</strong>
        <%= subscription.started_at.strftime("%d %B %Y") %>
      </p>

      <p>
        <strong>Status:</strong>
        <% if status&.status == "active" %>
          <span class="badge bg-success">Active</span>
        <% else %>
          <span class="badge bg-secondary">
            <%= status&.status&.humanize || "Unknown" %>
          </span>
        <% end %>
      </p>

      <p class="mb-0">
        <strong>Using:</strong>
        <%= status&.is_using ? "Yes" : "No" %>
      </p>
    </div>
  </div>
</div>
